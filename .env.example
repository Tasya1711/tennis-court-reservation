# Copy this file to .env.local for local development and fill in real values there.
# .env.local (and any other real env file) is gitignored — never commit actual secrets.

# ── Client-exposed (safe for the browser — Next.js only exposes NEXT_PUBLIC_ vars) ──
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Server-only secrets (never referenced in client components, never sent to the browser) ──

# Supabase project settings → Database → Connect → "Transaction pooler" (port 6543) — used by the app at runtime
DATABASE_URL=
# Supabase project settings → Database → Connect → "Session pooler" (port 5432) — used by Prisma Migrate.
# Not the raw "Direct connection" host (db.<ref>.supabase.co) — that one is IPv6-only unless your
# project has the paid IPv4 add-on, and is typically unreachable otherwise.
DIRECT_URL=
# Supabase project settings → API → service_role key (bypasses RLS — server-only, high privilege)
SUPABASE_SERVICE_ROLE_KEY=

# WayForPay — use the published sandbox test credentials for development:
#   WAYFORPAY_MERCHANT_ACCOUNT=test_merch_n1
#   WAYFORPAY_SECRET_KEY=flk3409refn54t54t*FNJRET
# Replace with real merchant credentials only once a production merchant account exists.
WAYFORPAY_MERCHANT_ACCOUNT=
WAYFORPAY_SECRET_KEY=
WAYFORPAY_MERCHANT_DOMAIN_NAME=localhost

# Shared secret Vercel Cron sends in a header to authenticate calls to /api/cron/expire-reservations
CRON_SECRET=
